{
  "name": "dsh-novel-craft",
  "description": "面向中文小说作者的 DeepSeek Harness 插件：用段落点赞/点踩提炼可编辑的偏好规则，再用于候选稿与局部改稿；本地保存，MIT 开源，需自备模型服务。",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/static-guard.test.mjs && node test/ledger.test.mjs && node test/plot.test.mjs && node test/pipeline.test.mjs && node test/host-api.test.mjs && node test/workbench.test.mjs && node test/client-render.test.mjs",
    "compat": "node scripts/check-dsh-compat.mjs",
    "test:workbench": "node test/workbench.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skills/"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "private": false,
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "novel",
    "writing",
    "taste-calibration",
    "creative-writing",
    "chinese",
    "writing-workbench",
    "chapter-board",
    "inline-annotations"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiyan688/dsh-novel-craft.git"
  },
  "homepage": "https://github.com/shiyan688/dsh-novel-craft",
  "bugs": {
    "url": "https://github.com/shiyan688/dsh-novel-craft/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
