{
  "name": "dsh-novel-craft",
  "description": "DSH 抽卡式作者选段工作台：把多个结构不同的候选稿摊开，作者只点哪段好哪段坏，标注沉淀成「作者偏好档案」，驱动下一轮收敛。",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/static-guard.test.mjs && node test/host-api.test.mjs && node test/client-render.test.mjs",
    "compat": "node scripts/check-dsh-compat.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skills/"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "private": false,
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "novel",
    "writing",
    "taste-calibration",
    "creative-writing",
    "chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiyan688/dsh-novel-craft.git"
  },
  "homepage": "https://github.com/shiyan688/dsh-novel-craft",
  "bugs": {
    "url": "https://github.com/shiyan688/dsh-novel-craft/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
